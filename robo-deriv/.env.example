# === PostgreSQL ===
POSTGRES_USER=deriv_admin
POSTGRES_PASSWORD=deriv_secret_pass
POSTGRES_DB=deriv_dca
DATABASE_URL=postgresql+psycopg2://deriv_admin:deriv_secret_pass@postgres:5432/deriv_dca

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Seguranca (TROCAR EM PRODUCAO!) ===
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria-com-mais-de-32-caracteres
ENCRYPTION_KEY=

# === Deriv API OAuth ===
# Registre seu App ID em https://developers.deriv.com apontando Redirect URL para:
# http://localhost:8095/auth/deriv/callback  (ou https://seu-dominio.com/auth/deriv/callback)
DERIV_APP_ID=1089
DERIV_PUBLIC_WS=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_AUTH_WS_BASE=wss://ws.derivws.com/websockets/v3

# === Admin Inicial (Seed automatico no primeiro boot) ===
ADMIN_EMAIL=admin@roboderiv.local
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrador

# === CORS ===
CORS_ORIGINS=http://localhost:8095,http://127.0.0.1:8095
